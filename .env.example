# Hub konfig — másold át .env-be és töltsd ki
#
# Production-ben /opt/hub/.env ide kerül, fejlesztéshez pedig a repo
# gyökerébe egy .env. A pydantic-settings előbb a repo .env-ből, utána
# a /opt/hub/.env-ből olvas, az utóbbi felülírja az előbbit.

# Kötelező — a session cookie és a meghívó-tokenek aláírásához
SECRET_KEY=dev-only-change-me-please

# URL és cookie
BASE_URL=http://127.0.0.1:8080
SECURE_COOKIES=false                  # production-ben true ha HTTPS
SESSION_LIFETIME_DAYS=60

# Adatbázis — fejlesztéshez relatív path, prod-ban abszolút /opt/hub/data
DATABASE_URL=sqlite:///./data/hub.db

# Storage path-ok
UPLOAD_DIR=./uploads
COREL_PREVIEW_DIR=./test_previews    # prod: /mnt/grafika/hub-previews

# Gemini API (Fázis 4 — email klasszifikációhoz)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# IMAP poller (Fázis 4)
IMAP_POLL_INTERVAL_SEC=60

# SMTP (Fázis 5 — árajánlat válaszhoz)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
