[Unit]
Description=Hub worker (IMAP poller + Corel preview watcher)
Documentation=https://github.com/gaberun24/hub.printbt.local
After=network-online.target hub.service
Wants=network-online.target

[Service]
Type=simple
User=hub
Group=hub
WorkingDirectory=/opt/hub/app
EnvironmentFile=/opt/hub/.env
ExecStart=/opt/hub/venv/bin/python -m app.workers.main
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hub/data /opt/hub/uploads
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hub-worker

[Install]
WantedBy=multi-user.target
