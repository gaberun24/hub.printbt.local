[Unit]
Description=Hub web app (FastAPI + Uvicorn)
Documentation=https://github.com/gaberun24/hub.printbt.local
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hub
Group=hub
WorkingDirectory=/opt/hub/app
EnvironmentFile=/opt/hub/.env
ExecStart=/opt/hub/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hub/data /opt/hub/uploads
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hub

[Install]
WantedBy=multi-user.target
